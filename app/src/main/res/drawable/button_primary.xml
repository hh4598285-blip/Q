<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#263142"/><corners android:radius="18dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#38BBD3"/><corners android:radius="18dp"/></shape>
    </item>
    <item>
        <shape><gradient android:angle="0" android:startColor="#5EE7FF" android:endColor="#7C5CFF"/><corners android:radius="18dp"/></shape>
    </item>
</selector>
